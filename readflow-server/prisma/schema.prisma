// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  // Use a string ID for compatibility with existing UUIDs if possible, 
  // or map existing UUIDs to this if we stick to Int. 
  // Given current system uses string UUIDs (simpleHash or nanoid), let's use String @id.
  // Actually, StorageService.ts uses string IDs. Let's keep String to minimize friction.
  uuid          String    @unique @default(uuid()) // Internal UUID
  
  // Existing fields
  username      String
  email         String?   @unique
  passwordHash  String?
  registeredAt  DateTime  @default(now())
  lastActive    DateTime  @default(now())
  
  // JSONB for Config Sync (Settings, Groups, etc.)
  syncData      Json?     @db.JsonB
  
  // Relations
  feeds         UserFeed[]
  articleStates UserArticleState[]
  sourceCursors UserSourceCursor[]
  syncDeliveries SyncDelivery[]

  @@map("users")
}

model RSSSource {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  name        String
  category    String   @default("General")
  
  // Status
  isActive    Boolean  @default(true)
  lastFetchAt DateTime?
  refreshIntervalSeconds Int? // Custom refresh interval
  refreshCron String?
  errorCount  Int      @default(0)
  lastErrorMessage String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  articles    Article[]
  users       UserFeed[]
  userCursors UserSourceCursor[]
  syncDeliveries SyncDelivery[]

  @@map("rss_sources")
}

model Article {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  content     String   @db.Text
  summary     String?  @db.Text
  author      String?
  publishedAt DateTime
  imageUrl    String?
  
  // Relations
  sourceId    Int
  source      RSSSource @relation(fields: [sourceId], references: [id])
  
  // User states are separate
  userStates  UserArticleState[]
  
  // New fields for stats
  wordCount   Int      @default(0)
  readingTime Int      @default(0)

  createdAt   DateTime @default(now())
  
  @@index([publishedAt])
  @@index([sourceId])
  @@map("articles")
}

model UserFeed {
  userId      String
  sourceId    Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User      @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  source      RSSSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@map("user_feeds")
}

model UserArticleState {
  id           Int      @id @default(autoincrement())
  userId       String
  articleUrl   String   // Link by URL to avoid strict FK constraint if article is deleted but state kept? 
                        // Better to link by FK to Article.id if possible, but existing system uses URL.
                        // Let's use Article FK for integrity.
  articleId    Int
  
  isRead       Boolean  @default(false)
  isFavorite   Boolean  @default(false)
  readProgress Int      @default(0)
  
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("user_article_states")
}

model UserSourceCursor {
  userId             String
  sourceId           Int
  lastAckedArticleId Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  source RSSSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@map("user_source_cursors")
}

model SyncDelivery {
  id              String   @id @default(uuid())
  userId          String
  sourceId        Int
  fromExclusiveId Int
  toInclusiveId   Int
  createdAt       DateTime @default(now())
  ackedAt         DateTime?

  user   User      @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  source RSSSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, sourceId, ackedAt])
  @@map("sync_deliveries")
}

model Vocabulary {
  id              Int      @id @default(autoincrement())
  word            String   @unique
  definition      Json?    @db.JsonB
  context         String?
  articleId       Int?
  sourceArticleId Int?     // Optional link to source article ID if known
  
  // SRS Stats
  reviewCount     Int      @default(0)
  correctCount    Int      @default(0)
  masteryLevel    Int      @default(0)
  difficulty      String   @default("medium")
  
  // Timestamps
  addedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime @default(now())
  
  // Meta
  tags            Json?    @db.JsonB
  notes           String?
  
  // Soft Delete
  isDeleted       Boolean  @default(false)

  @@map("vocabulary")
}

model ServerSetting {
  key       String   @id
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("server_settings")
}

model LegacySyncBlockStore {
  key       String   @id
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legacy_sync_blocks")
}

model DailyReport {
  id           Int      @id @default(autoincrement())
  userId       String                 // 关联用户 ID (对应 User.uuid)
  title        String                 // 日报标题
  content      String   @db.Text      // LLM 生成的 Markdown 摘要
  sourceUrls   Json     @db.JsonB     // 参与总结的文章 URL 列表
  articleCount Int                    // 总结的文章数量
  groupNames   Json     @db.JsonB     // 使用的分组名称
  isRead       Boolean  @default(false) // 是否已读
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId, generatedAt])
  @@map("daily_reports")
}
