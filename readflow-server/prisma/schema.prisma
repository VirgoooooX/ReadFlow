// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  // Use a string ID for compatibility with existing UUIDs if possible, 
  // or map existing UUIDs to this if we stick to Int. 
  // Given current system uses string UUIDs (simpleHash or nanoid), let's use String @id.
  // Actually, StorageService.ts uses string IDs. Let's keep String to minimize friction.
  uuid          String    @unique @default(uuid()) // Internal UUID
  
  // Existing fields
  username      String
  email         String?   @unique
  passwordHash  String?
  registeredAt  DateTime  @default(now())
  lastActive    DateTime  @default(now())
  
  // JSONB for Config Sync (Settings, Groups, etc.)
  syncData      Json?     @db.JsonB
  
  // Relations
  feeds         UserFeed[]
  articleStates UserArticleState[]

  @@map("users")
}

model RSSSource {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  name        String
  category    String   @default("General")
  
  // Status
  isActive    Boolean  @default(true)
  lastFetchAt DateTime?
  errorCount  Int      @default(0)
  lastErrorMessage String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  articles    Article[]
  users       UserFeed[]

  @@map("rss_sources")
}

model Article {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  content     String   @db.Text
  summary     String?  @db.Text
  author      String?
  publishedAt DateTime
  imageUrl    String?
  
  // Relations
  sourceId    Int
  source      RSSSource @relation(fields: [sourceId], references: [id])
  
  // User states are separate
  userStates  UserArticleState[]

  createdAt   DateTime @default(now())
  
  @@index([publishedAt])
  @@index([sourceId])
  @@map("articles")
}

model UserFeed {
  userId      String
  sourceId    Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User      @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  source      RSSSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@map("user_feeds")
}

model UserArticleState {
  id           Int      @id @default(autoincrement())
  userId       String
  articleUrl   String   // Link by URL to avoid strict FK constraint if article is deleted but state kept? 
                        // Better to link by FK to Article.id if possible, but existing system uses URL.
                        // Let's use Article FK for integrity.
  articleId    Int
  
  isRead       Boolean  @default(false)
  isFavorite   Boolean  @default(false)
  readProgress Int      @default(0)
  
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("user_article_states")
}

model ServerSetting {
  key       String   @id
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("server_settings")
}

model LegacySyncBlockStore {
  key       String   @id
  data      Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legacy_sync_blocks")
}
