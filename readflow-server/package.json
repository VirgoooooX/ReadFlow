{
  "name": "readflow-server",
  "version": "4.1.0",
  "description": "ReadFlow Server: an Express/Prisma backend for RSS fetching, cloud sync, image proxying, admin operations, daily reports, and LLM gateway services.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "db:up": "docker-compose up -d",
    "db:migrate": "npx prisma migrate dev",
    "db:import": "ts-node scripts/migrate-json-to-pg.ts",
    "release": "node scripts/release.mjs",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "5.7.0",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.9.3",
    "he": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "linkedom": "^0.16.8",
    "node-fetch": "^2.7.0",
    "p-limit": "^3.1.0",
    "prisma": "5.7.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/node-fetch": "^2.6.9",
    "@vitest/ui": "^4.1.9",
    "fast-check": "^4.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "changelog": [
    "feat: implement server architecture including admin authentication, storage services, and RSS processing utilities",
    "feat: implement admin dashboard UI with Tailwind CSS and layout structure"
  ]
}
